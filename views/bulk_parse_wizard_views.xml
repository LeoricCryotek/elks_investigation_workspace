<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bulk_parse_wizard_form" model="ir.ui.view">
            <field name="name">elks.investigation.bulk_parse.wizard.form</field>
            <field name="model">elks.investigation.bulk_parse.wizard</field>
            <field name="arch" type="xml">
                <form string="Paste &amp; Parse Search Results">
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            <strong>How this works:</strong> open the portal in your browser,
                            run the search, select the visible block of results, copy (⌘C / Ctrl-C),
                            and paste into the box below. Click <em>Parse Preview</em> to see what
                            was extracted. Edit the preview JSON if anything looks off, then click
                            <em>Add to Check</em>.
                        </div>
                        <group>
                            <field name="check_id" readonly="1"/>
                        </group>
                        <separator string="Paste the search results"/>
                        <field name="pasted_text" nolabel="1" widget="text"
                               placeholder="Paste from the portal here…"/>
                        <footer>
                            <button name="action_preview" string="Parse Preview"
                                    type="object" class="btn-primary"
                                    invisible="not pasted_text"/>
                            <button special="cancel" string="Cancel"/>
                        </footer>
                        <separator string="Parsed preview"
                                   invisible="parsed_count == 0"/>
                        <group invisible="parsed_count == 0">
                            <field name="parser_used" readonly="1"/>
                            <field name="parsed_count" readonly="1"/>
                        </group>
                        <field name="parsed_json" nolabel="1" widget="text"
                               invisible="parsed_count == 0"
                               help="Edit this JSON to fix any misparses before clicking Add to Check."/>
                        <footer invisible="parsed_count == 0">
                            <button name="action_commit" string="Add to Check"
                                    type="object" class="btn-primary"
                                    confirm="Add the parsed records as Hits and re-run the cross-check?"/>
                            <button special="cancel" string="Cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_bulk_parse_wizard" model="ir.actions.act_window">
            <field name="name">Paste &amp; Parse Search Results</field>
            <field name="res_model">elks.investigation.bulk_parse.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
