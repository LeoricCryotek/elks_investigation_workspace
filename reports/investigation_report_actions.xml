<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- One-page summary (default) -->
        <record id="action_report_investigation_summary" model="ir.actions.report">
            <field name="name">Investigation Summary (1 page)</field>
            <field name="model">elks.membership.application</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">elks_investigation_workspace.report_investigation_summary</field>
            <field name="report_file">elks_investigation_workspace.report_investigation_summary</field>
            <field name="print_report_name">f"Investigation_Summary_{object.name}_{(object.applicant_display_name or 'applicant').replace(' ', '_')}"</field>
        </record>

        <!-- Detailed report (opt-in) -->
        <record id="action_report_investigation" model="ir.actions.report">
            <field name="name">Investigation Detailed Report</field>
            <field name="model">elks.membership.application</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">elks_investigation_workspace.report_investigation</field>
            <field name="report_file">elks_investigation_workspace.report_investigation</field>
            <field name="print_report_name">f"Investigation_Detailed_{object.name}_{(object.applicant_display_name or 'applicant').replace(' ', '_')}"</field>
        </record>
    </data>
</odoo>
